# Copy this file to .env and fill in your local SQL Server password.
# The C# backend reads TOW_DB_CONNECTION_STRING from .env or OS environment variables.
TOW_DB_CONNECTION_STRING=Server=localhost;Database=GIN401_TowDispatch;User Id=tow_cad_app_login;Password=REPLACE_WITH_YOUR_PASSWORD;TrustServerCertificate=True;
